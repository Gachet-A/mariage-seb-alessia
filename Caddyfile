{
	admin off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# /vert = same page, green palette (theme picked from the URL in index.html)
	redir /vert/ /vert
	rewrite /vert /index.html
	# /choix = both versions side by side
	rewrite /choix /choix.html

	file_server

	# Fonts and photos never change name-for-content; cache them for a week.
	@assets path /fonts/* /images/*
	header @assets Cache-Control "public, max-age=604800"

	# HTML, CSS and JS: always revalidate so edits show up right away.
	@pages not path /fonts/* /images/*
	header @pages Cache-Control "no-cache"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
