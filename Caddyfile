{
	admin off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	file_server

	# Font and image files: cache for a week (new versions get new file names).
	@assets path *.woff2 *.webp *.ico
	header @assets Cache-Control "public, max-age=604800"
	@woff2 path *.woff2
	header @woff2 Content-Type font/woff2

	# HTML, CSS and JS (including fonts/fonts.css): always revalidate so edits show up right away.
	@pages not path *.woff2 *.webp *.ico
	header @pages Cache-Control "no-cache"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
